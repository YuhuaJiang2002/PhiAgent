{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuhuajiang2002.github.io/PhiAgent/schemas/phiagent-bench-suite-0.1.0.json",
  "title": "PhiAgent-Bench suite v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "version", "cases"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id", "task_name", "task_family", "track", "split",
          "source_uri", "source_interface", "target", "camera_frame",
          "world_frame", "robot_base_frame", "required_dimensions"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "task_name": {"type": "string", "minLength": 1},
          "task_family": {
            "enum": [
              "f1_rigid_rearrangement", "f2_mechanism_actuation",
              "f3_insertion_assembly", "f4_deformable_configuration",
              "f5_bulk_material_transfer", "f6_surface_transformation"
            ]
          },
          "track": {
            "enum": [
              "h2r_transfer", "action_reconstruction",
              "cross_embodiment", "policy_utility"
            ]
          },
          "split": {"type": "string", "minLength": 1},
          "source_uri": {"type": "string", "minLength": 1},
          "source_interface": {"type": "string", "minLength": 1},
          "target": {"$ref": "#/$defs/embodiment"},
          "camera_frame": {"type": "string", "minLength": 1},
          "world_frame": {"type": "string", "minLength": 1},
          "robot_base_frame": {"type": "string", "minLength": 1},
          "required_dimensions": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {"enum": ["l1_visual", "l2_geometry", "l3_action", "l4_sim", "l5_real"]}
          },
          "required_metrics": {"type": "object"},
          "annotation": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "embodiment": {
      "type": "object",
      "required": ["robot_model", "end_effector", "arm_count", "arm_dof"],
      "properties": {
        "robot_model": {"type": "string", "minLength": 1},
        "end_effector": {"type": "string", "minLength": 1},
        "arm_count": {"type": "integer", "minimum": 1},
        "arm_dof": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "urdf_uri": {"type": ["string", "null"]}
      }
    }
  }
}
