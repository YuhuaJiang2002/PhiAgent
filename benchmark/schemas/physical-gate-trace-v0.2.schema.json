{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuhuajiang2002.github.io/PhiAgent/schemas/physical-gate-trace-0.2.0.json",
  "title": "PhiAgent-Bench physical gate trace v0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "backend", "source_revision", "episode_id",
    "initial_state_id", "seed", "task_success", "stage_results",
    "contact_results", "samples"
  ],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "backend": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "initial_state_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "task_success": {"type": "boolean"},
    "stage_results": {
      "type": "array", "minItems": 1, "items": {"type": "boolean"}
    },
    "contact_results": {
      "type": "array", "minItems": 1, "items": {"type": "boolean"}
    },
    "samples": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestamp_s", "ik_success", "joint_limit_violation",
          "velocity_violation", "forbidden_collision", "singularity"
        ],
        "properties": {
          "timestamp_s": {"type": "number", "minimum": 0},
          "ik_success": {"type": "boolean"},
          "joint_limit_violation": {"type": "boolean"},
          "velocity_violation": {"type": "boolean"},
          "forbidden_collision": {"type": "boolean"},
          "singularity": {"type": "boolean"}
        }
      }
    }
  }
}
