{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuhuajiang2002.github.io/PhiAgent/schemas/phiagent-bench-submission-0.1.0.json",
  "title": "PhiAgent-Bench submission v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "method", "suite_name", "records"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "method": {"type": "string", "minLength": 1},
    "suite_name": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "generated_uri"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "generated_uri": {"type": "string", "minLength": 1},
          "visual": {"type": ["object", "null"]},
          "geometry": {"type": ["object", "null"]},
          "action": {"type": ["object", "null"]},
          "simulation": {"type": ["object", "null"]},
          "real": {"type": ["object", "null"]},
          "runtime": {"type": ["object", "null"]},
          "policy_utility": {"type": ["object", "null"]}
        }
      }
    }
  }
}
