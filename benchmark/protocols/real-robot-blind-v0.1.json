{
  "schema_version": "0.1.0",
  "protocol_id": "phiagent-real-robot-blind-v0.1",
  "eligibility": {
    "requires_complete_l4_pass": true,
    "adapter_execution_enabled": true,
    "calibration_bound_to_robot_serial": true,
    "action_and_scene_hash_frozen_before_execution": true
  },
  "design": {
    "minimum_trials_per_case_and_embodiment": 10,
    "minimum_independent_sessions": 3,
    "randomize_case_order": true,
    "fixed_timeout_per_case": true,
    "operator_and_outcome_reviewer_separated": true,
    "reviewer_blinded_to_method_and_seed": true,
    "all_attempts_retained": true,
    "human_intervention_counts_as_failure": true
  },
  "required_artifacts": [
    "pre_registered_case_manifest",
    "calibration",
    "initial_state_video",
    "predicted_video",
    "executed_action",
    "execution_video",
    "timestamped_joint_eef_gripper_telemetry",
    "force_and_safety_log",
    "blind_stage_and_task_outcome"
  ],
  "reported_metrics": [
    "coverage",
    "real_precision_lower_bound",
    "real_audit_completion",
    "observed_sim_false_accept_rate",
    "e2e_valid_success_rate",
    "e2e_valid_success_wilson_95ci",
    "valid_data_goodput_seconds_per_gpu_hour"
  ],
  "initial_anchor_embodiments": [
    "dual RealMan RM65-B + ChangingTek CTAG2F90-D",
    "Franka FR3 + validated parallel-jaw gripper",
    "Universal Robots UR5e + validated parallel-jaw gripper"
  ],
  "safety_boundary": "This protocol defines evidence and reporting. It does not enable hardware control; each execution adapter requires separate safety review and site authorization."
}
