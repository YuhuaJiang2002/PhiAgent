# Copy this file to .env and fill only the provider you use.
# Never commit the real .env file.

# API keys
# HUNYUAN_API_KEY=your-key
# DASHSCOPE_API_KEY=your-key
# OPENAI_API_KEY=your-key
# ARK_API_KEY=your-ark-key

# Optional model overrides
# HUNYUAN_MODEL=hunyuan-turbos-latest
# DASHSCOPE_MODEL=qwen-plus
# OPENAI_MODEL=gpt-5-mini
# ARK_MODEL=doubao-seed-2.0-pro

# Coding Plan endpoint; omit this for Ark's regular online-inference endpoint.
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3

# Local server (no API key)
# QWEN38_MODEL=qwen3.8-27b-fp8
