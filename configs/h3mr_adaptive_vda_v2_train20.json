{
  "schema_version": "1.0.0",
  "method": "Stage-3-BIR + Adaptive VDA",
  "implementation_version": "adaptive-vda-v2-hand-root-depth-v1",
  "candidate_generation_uses_3d_gt": false,
  "routing": {
    "v1_hard_if": "valid_keyframes < 4 OR scale_relative_mad > 0.20",
